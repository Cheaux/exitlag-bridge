+/* ExitLag-only minimize frame retention; no images leave this process. */
+static char frameKey, timeKey, overlayKey;
+@interface ExitLagSnapshotView : NSImageView
+@end
+@implementation ExitLagSnapshotView
+- (NSView *)hitTest:(NSPoint)point { return nil; }
+@end
+
+static BOOL isClient(NSWindow *window)
+{
+    return [window.title isEqualToString:@"ExitLag"];
+}
+
+static void exitlag_remember_frame(id view, CGImageRef image)
+{
+    NSWindow *window = [(NSView *)view window];
+    if (!image || !isClient(window) || !window.visible || window.miniaturized) return;
+    NSRect bounds = [(NSView *)view bounds];
+    size_t width = CGImageGetWidth(image), height = CGImageGetHeight(image);
+    if (width < 480 || height < 270 || width > 8192 || height > 8192 || width * height > 8 * 1024 * 1024 ||
+        width < bounds.size.width * .9 || height < bounds.size.height * .9) return;
+    CFTimeInterval now = CACurrentMediaTime();
+    NSNumber *previous = objc_getAssociatedObject(window, &timeKey);
+    if (previous && now - previous.doubleValue < .2) return;
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGContextRef context = CGBitmapContextCreate(NULL, width, height, 8, width * 4,
+        space, kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+    CGColorSpaceRelease(space);
+    if (!context) return;
+    CGContextDrawImage(context, CGRectMake(0, 0, width, height), image);
+    const unsigned char *pixels = CGBitmapContextGetData(context);
+    unsigned white = 0;
+    for (unsigned y = 1; y <= 4; y++) for (unsigned x = 1; x <= 4; x++) {
+        const unsigned char *p = pixels + ((height * y / 5) * width + width * x / 5) * 4;
+        if (p[0] > 245 && p[1] > 245 && p[2] > 245) white++;
+    }
+    if (white < 16) {
+        CGImageRef copy = CGBitmapContextCreateImage(context);
+        if (copy) {
+            NSImage *snapshot = [[NSImage alloc] initWithCGImage:copy size:bounds.size];
+            objc_setAssociatedObject(window, &frameKey, snapshot, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            objc_setAssociatedObject(window, &timeKey, @(now), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            [snapshot release];
+            CGImageRelease(copy);
+        }
+    }
+    CGContextRelease(context);
+}
+
+static void exitlag_preserve_frame(id window)
+{
+    if (isClient(window) && !stage_manager_enabled()) {
+        NSImage *image = objc_getAssociatedObject(window, &frameKey);
+        if (image) {
+            [objc_getAssociatedObject(window, &overlayKey) removeFromSuperview];
+            NSView *content = [(NSWindow *)window contentView];
+            ExitLagSnapshotView *overlay = [[ExitLagSnapshotView alloc] initWithFrame:content.bounds];
+            overlay.image = image;
+            overlay.imageScaling = NSImageScaleAxesIndependently;
+            overlay.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+            overlay.wantsLayer = YES;
+            overlay.layer.zPosition = 10000;
+            [content addSubview:overlay positioned:NSWindowAbove relativeTo:nil];
+            objc_setAssociatedObject(window, &overlayKey, overlay, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            [overlay displayIfNeeded];
+            [content displayIfNeeded];
+            [CATransaction flush];
+            [overlay release];
+            fprintf(stderr, "ExitLag animation [%d]: preserved client frame\n", getpid());
+        } else fprintf(stderr, "ExitLag animation [%d]: no GDI frame available\n", getpid());
+    }
+}
+
+static void exitlag_restore_frame(id window)
+{
+    NSView *overlay = objc_getAssociatedObject(window, &overlayKey);
+    /* Wine deliberately disables automatic resizing of its Win32 subviews. */
+    if (overlay) [overlay setFrame:[(NSWindow *)window contentView].bounds];
+    if (overlay) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 150 * NSEC_PER_MSEC),
+        dispatch_get_main_queue(), ^{
+            [overlay removeFromSuperview];
+            if (objc_getAssociatedObject(window, &overlayKey) == overlay)
+                objc_setAssociatedObject(window, &overlayKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        });
+}
