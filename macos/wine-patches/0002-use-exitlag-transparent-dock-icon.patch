     - (void) setApplicationIconFromCGImageArray:(NSArray*)images
     {
+        const char *iconPath = getenv("EXITLAG_MACOS_APP_ICON");
+        if (iconPath)
+        {
+            NSString *path = [NSString stringWithUTF8String:iconPath];
+            if ([[path lastPathComponent] isEqualToString:@"ClientIcon.icns"])
+            {
+                NSImage *icon = [[NSImage alloc] initWithContentsOfFile:path];
+                if (icon)
+                {
+                    self.applicationIcon = icon;
+                    [NSApp setApplicationIconImage:icon];
+                    NSDockTile *tile = [NSApp dockTile];
+                    ExitLagDockView *view = [[ExitLagDockView alloc] initWithIcon:icon size:tile.size];
+                    tile.contentView = view;
+                    [tile display];
+                    dispatch_async(dispatch_get_main_queue(), ^{ [tile display]; });
+                    [view release];
+                    [icon release];
+                    return;
+                }
+            }
