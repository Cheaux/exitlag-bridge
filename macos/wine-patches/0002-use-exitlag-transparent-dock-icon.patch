# Wine 11.17: draw the locally extracted icon only for the ExitLag launcher.
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -95,6 +95,38 @@
 @end
 
 
+/* ExitLag-only Dock drawing; no other Wine application opts into this view. */
+@interface ExitLagDockView : NSView
+{
+    NSImage *icon;
+    BOOL reported;
+}
+- (id)initWithIcon:(NSImage *)image size:(NSSize)size;
+@end
+@implementation ExitLagDockView
+- (id)initWithIcon:(NSImage *)image size:(NSSize)size
+{
+    self = [super initWithFrame:NSMakeRect(0, 0, size.width, size.height)];
+    if (self) icon = [image retain];
+    return self;
+}
+- (void)dealloc { [icon release]; [super dealloc]; }
+- (BOOL)isOpaque { return NO; }
+- (void)drawRect:(NSRect)dirty
+{
+    [[NSColor clearColor] setFill];
+    NSRectFillUsingOperation(self.bounds, NSCompositingOperationCopy);
+    [icon drawInRect:self.bounds fromRect:NSZeroRect operation:NSCompositingOperationSourceOver
+        fraction:1 respectFlipped:YES hints:nil];
+    if (!reported)
+    {
+        fprintf(stderr, "ExitLag Dock icon: transparent view drawn\n");
+        reported = YES;
+    }
+}
+@end
+
